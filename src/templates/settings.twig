{# @var settings \twentyfourhoursmedia\poll\models\Settings #}
{% import "_includes/forms" as forms %}

<h2>{{ 'Settings'|t('poll') }}</h2>

{{ forms.lightSwitchField({
    label: 'Block plugin uninstall'|t('poll'),
    instructions: 'Prevents removal of the plugin. Removing the plugin will also remove all of the submitted data, so you might want to backup first.'|t('poll'),
    id: 'blockPluginRemoval',
    name: 'blockPluginRemoval',
    on: settings.blockPluginRemoval,
    errors: settings.getErrors('blockPluginRemoval'),
}) }}

<h3>{{ 'Cookie'|t('poll') }}</h3>

<p>{{ 'For anonymous participation, the latest polls in which one has participated are kept in a cookie.'|t('poll') }}</p>

{{ forms.textField({
    label: 'Number of participations to keep in a cookie'|t('poll'),
    instructions: 'Number of poll participations to keep. Setting this to a large value increases cookie size.'|t('poll'),
    id: 'numCookieParticipations',
    name: 'numCookieParticipations',
    type: 'number',
    size: 10,
    value: settings.numCookieParticipations,
    errors: settings.getErrors('numCookieParticipations'),
}) }}

{{ forms.textField({
    label: 'Participation cookie lifetime in days'|t('poll'),
    instructions: 'Number of days to keep the participations cookie.'|t('poll'),
    id: 'participationsCookieLifetime',
    name: 'participationsCookieLifetime',
    type: 'number',
    size: 10,
    value: settings.participationsCookieLifetime,
    errors: settings.getErrors('participationsCookieLifetime'),
}) }}

<hr/>

<h2>{{ 'Additional setup'|t('poll') }}</h2>

<p>
    <strong>{{ 'You can set up the sections and fields in the Poll utility.'|t('poll') }}
        <a href="{{ url('utilities/poll-poll-utility') }}">{{ 'Go there'|t('poll') }} &raquo;</a></strong>
</p>

<p>
    {{ 'If you have not yet set up the fields and want to change the default handles, you can do so by placing a poll.php in the /config directory with customized settings:'|t('poll') }}
</p>

<pre><code>
// example config file to override section handles etc
// these settings override the settings set from the CP
return [
    // configure handles for installation

    // the section containing polls
    // default: pollSection
    'sectionHandle' => '',

    // the field that is generated to select a poll
    // default: selectedPoll
    'selectPollFieldHandle' => '',

    // the Matrix field that contains 'answers'
    // default: pollAnswerMatrix
    'answerMatrixFieldHandle' => '',

    // within the answerMatrixFieldHandle, an entry type is created that will contain the answers.
    // this is the handle for that entry type.
    // default: pollAnswer
    'matrixBlockAnswerHandle' => ''
];
</code></pre>
