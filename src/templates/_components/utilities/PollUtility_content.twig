{# @var allow_admin_changes bool #}
{# @var setup_ok bool #}
{# @var setup_report \twentyfourhoursmedia\poll\models\SetupReport #}
{# @var selectPollFieldHandle string #}

<h1>{{ 'Poll utility'|t('poll') }}</h1>

<p><strong>{{ 'The setup of Craft appears'|t('poll') }} {{ setup_ok ? 'OK' : 'NOT OK' }}</strong></p>
<p>{{ 'Checks:'|t('poll') }}</p>
<ul>
    {% for item in setup_report.items %}
        <li><strong>{{ item.level }}:</strong> {{ item.description }}
            {% if item.fix %}(<small style="font-size: 80%;">{{ item.fix }}</small>){% endif %}
        </li>
    {% endfor %}
</ul>

{% if setup_ok %}
    <p><strong>{{ "You can now add the field '{handle}' to your entry types to select a poll, or create a poll in the polls section."|t('poll', { handle: selectPollFieldHandle }) }}</strong></p>
{% endif %}

<hr/>
{% if allow_admin_changes %}
    <form method="post" action="{{ actionUrl('poll/install/setup') }}">
        {{ csrfInput() }}
        {{ redirectInput(url('utilities/poll-poll-utility')) }}
        <button type="submit" class="btn submit">{{ 'Setup content sections and fields'|t('poll') }}</button>
    </form>
{% else %}
    <p>{{ 'This environment needs to allow admin changes to set up sections and fields.'|t('poll') }}</p>
    <button type="submit" class="btn submit disabled" disabled="disabled">{{ 'Setup content sections and fields'|t('poll') }}</button>
{% endif %}
