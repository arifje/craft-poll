{# @var poll \craft\elements\Entry #}
{# @var simple_results \twentyfourhoursmedia\poll\models\PollResults #}
{# @var service \twentyfourhoursmedia\poll\services\Facade #}

{% extends '_layouts/cp' %}

{% set title = 'Results for poll'|t('poll') ~ ': ' ~ poll.title %}
{% set crumbs = [
    { label: 'Poll results'|t('poll'), url: url('poll') },
] %}

{% block content %}
    <p class="light">ID={{ poll.id }}</p>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th scope="col">{{ 'Answer'|t('poll') }}</th>
                <th scope="col">{{ 'Votes'|t('poll') }}</th>
                <th scope="col">{{ 'Share'|t('poll') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for result_item in simple_results.byAnswer %}
                {% set answer = result_item.answer %}
                <tr>
                    <th scope="row">{{ answer.label ?? '(unlabeled)' }}</th>
                    <td>{{ result_item.count }} {{ 'votes'|t('poll') }}</td>
                    <td>{{ result_item.percent is null ? '–' : result_item.percent|round ~ '%' }}</td>
                </tr>
            {% endfor %}
            <tr>
                <th scope="row">{{ 'Total votes'|t('poll') }}</th>
                <td>{{ simple_results.count }}</td>
                <td></td>
            </tr>
        </tbody>
    </table>

    <hr>

    <h2>{{ 'Data download'|t('poll') }}</h2>
    <p>{{ 'You can download raw data here for further marketing analysis or targeting.'|t('poll') }}</p>
    <form method="post" action="{{ actionUrl('poll/download/poll-data', { id: poll.id }) }}">
        {{ csrfInput() }}
        <button type="submit" class="btn submit">{{ 'Download data in CSV format'|t('poll') }}</button>
    </form>
{% endblock %}
